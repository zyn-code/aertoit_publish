# Copy to .env and adjust. XAMPP's MariaDB defaults to root with no password.
NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aertoit
DB_POOL_SIZE=10

# Angular dev server (4200) and SSR server (4000)
CORS_ORIGINS=http://localhost:4200,http://localhost:4000

UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=5242880

# --- managed database (deployment) -----------------------------------
# Every hosted MySQL requires TLS; leave DB_SSL unset for local XAMPP.
# DB_SSL=true
# Only when the provider presents its own CA rather than a public root:
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n…"
